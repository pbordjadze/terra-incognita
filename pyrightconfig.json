// pyright (standard mode) over the Python tools and checks; `python3 ci/ratchet.py types` holds each file's error
// count to ci/ceilings/types.txt. Missing third-party imports are warnings: the tools' heavier packages (scipy,
// rasterio, netCDF4) are installed only where a tool runs, not in CI.
{
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "exclude": [".venv", "**/node_modules", "**/__pycache__"],
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
