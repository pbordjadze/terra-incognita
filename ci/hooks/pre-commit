#!/usr/bin/env bash
# The fast checks, on what this commit changes, in seconds, so a slip is caught before CI takes it.
# Turned on per clone: `git config core.hooksPath ci/hooks` (.claude/settings.json does it for every
# Claude Code session). Clippy, SwiftLint and the tests stay in CI (`bash ci/lint.sh` runs them all here).
#   rustfmt         the workspaces whose Rust is staged (`bash ci/lint.sh fix` formats)
#   ruff            the staged Python
#   ShellCheck      the staged shell scripts
#   ci/ratchet.py   file length, function complexity and Python types, on the staged files
#   ci/silenced.py  over the repository
# A tool that isn't installed is skipped with a note (CI's lint job runs it). Skipping the hook
# (`git commit --no-verify`) only defers the same checks to CI. Written for bash 3.2, macOS's own.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
[ -d .venv/bin ] && PATH="$PWD/.venv/bin:$PATH"

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
  < <(git diff --cached -z --name-only --diff-filter=ACMR -- . ':!ci/qa/*')
[ ${#staged[@]} -eq 0 ] && exit 0

failed=()
# check <name> <command...>: runs it, and shows its output only if it fails
check() { local name="$1" out; shift; out=$("$@" 2>&1) || { echo "$out"; failed+=("$name"); }; }
has() { command -v "$1" > /dev/null || { echo "pre-commit: $1 not installed, skipped (CI's lint job runs it)"; return 1; }; }
# pick <ending> [<directory>/]: prints the staged files with that ending (under that directory), one a line
pick() { local f; for f in "${staged[@]}"; do [[ $f == *"$1" && $f == "${2:-}"* ]] && echo "$f"; done; return 0; }
# files <ending>: fills the array `found` with the staged files with that ending
files() { local f; found=(); while IFS= read -r f; do found+=("$f"); done < <(pick "$1"); }

for ws in toys adrift; do
  if [ -n "$(pick .rs "$ws/")" ] && has cargo; then
    check "rustfmt ($ws)" bash -c "cd $ws && cargo fmt --all -- --check || { echo 'rustfmt: $ws needs formatting: bash ci/lint.sh fix'; exit 1; }"
  fi
done
files .py
[ ${#found[@]} -gt 0 ] && has ruff && check ruff ruff check --quiet "${found[@]}"
files .sh
[ ${#found[@]} -gt 0 ] && has shellcheck && check shellcheck shellcheck "${found[@]}"
check "ratchet" python3 ci/ratchet.py sizes "${staged[@]}"
if has lizard; then check "ratchet" python3 ci/ratchet.py complexity "${staged[@]}"; fi
files .py
if [ ${#found[@]} -gt 0 ] && has pyright; then check "ratchet" python3 ci/ratchet.py types "${found[@]}"; fi
check "silenced lints" python3 ci/silenced.py

if [ ${#failed[@]} -gt 0 ]; then
  echo "pre-commit: failed: ${failed[*]}"
  exit 1
fi
exit 0
