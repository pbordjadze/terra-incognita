// ---- geometry

#define MTL_GEOMETRY(T) \
    inline float dot(T a, T b) { T p = a * b; float s = 0; for (int i = 0; i < __mtl::count<T>(); i++) s += p[i]; return s; } \
    inline float length_squared(T a) { return dot(a, a); } \
    inline float length(T a) { return __builtin_sqrtf(dot(a, a)); } \
    inline float distance(T a, T b) { return length(a - b); } \
    inline float distance_squared(T a, T b) { return dot(a - b, a - b); } \
    inline T normalize(T a) { return a * (1.0f / length(a)); } \
    inline T reflect(T i, T n) { return i - 2.0f * dot(n, i) * n; } \
    inline T faceforward(T n, T i, T nref) { return dot(nref, i) < 0.0f ? n : -n; }
MTL_GEOMETRY(float2) MTL_GEOMETRY(float3) MTL_GEOMETRY(float4)
