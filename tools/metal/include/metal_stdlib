template <int N> inline __mtl_matrix<N, N> transpose(const __mtl_matrix<N, N> &m) {
    __mtl_matrix<N, N> r;
    for (int c = 0; c < N; c++) for (int k = 0; k < N; k++) r.columns[c][k] = m.columns[k][c];
    return r;
}
