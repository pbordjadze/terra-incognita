// A comparison of vectors gives a vector of ints, -1 where true (clang's rule; Metal's gives bools):
// boolN is that type, so `bool3 b = v < w`, select, all and any read as Metal's do. A comparison
// among a vector's elements, float3(v < w), is rewritten to give 1 and 0 (metal.py); a bool vector
// held in a variable and then converted, float3(b), would give -1: compare in the conversion.
typedef int2 bool2;
typedef int3 bool3;
typedef int4 bool4;

// ---- vector construction: metal.py rewrites float3(a, b, c) to __mtl_make<float3>(a, b, c), which
// takes scalars and vectors in any mix (as Metal does) and converts values, never bits

namespace __mtl {
template <class T> struct traits { static constexpr int n = 0; };
#define MTL_TRAITS(V, E, N) template <> struct traits<V> { static constexpr int n = N; typedef E elem; };
MTL_TRAITS(float, float, 1) MTL_TRAITS(float2, float, 2) MTL_TRAITS(float3, float, 3) MTL_TRAITS(float4, float, 4)
MTL_TRAITS(int, int, 1) MTL_TRAITS(int2, int, 2) MTL_TRAITS(int3, int, 3) MTL_TRAITS(int4, int, 4)
MTL_TRAITS(uint, uint, 1) MTL_TRAITS(uint2, uint, 2) MTL_TRAITS(uint3, uint, 3) MTL_TRAITS(uint4, uint, 4)
MTL_TRAITS(short, short, 1) MTL_TRAITS(short2, short, 2) MTL_TRAITS(short3, short, 3) MTL_TRAITS(short4, short, 4)
MTL_TRAITS(ushort, ushort, 1) MTL_TRAITS(ushort2, ushort, 2) MTL_TRAITS(ushort3, ushort, 3) MTL_TRAITS(ushort4, ushort, 4)
MTL_TRAITS(uchar, uchar, 1) MTL_TRAITS(uchar2, uchar, 2) MTL_TRAITS(uchar3, uchar, 3) MTL_TRAITS(uchar4, uchar, 4)
MTL_TRAITS(bool, bool, 1) MTL_TRAITS(double, double, 1) MTL_TRAITS(long, long, 1) MTL_TRAITS(unsigned long, unsigned long, 1)
#undef MTL_TRAITS

template <class T> constexpr int count() { return traits<T>::n; }
template <class... A> constexpr int total() { return (0 + ... + count<A>()); }

template <class E, class A> inline void put(E *out, int &k, A a) {
    if constexpr (count<A>() == 1) out[k++] = E(a);
    else for (int i = 0; i < count<A>(); i++) out[k++] = E(a[i]);
}

template <class V> struct zero_last { static V of() { return V(0); } };
}  // namespace __mtl

template <class V, class... A> inline V __mtl_make(A... a) {
    typedef typename __mtl::traits<V>::elem E;
    constexpr int n = __mtl::traits<V>::n, given = __mtl::total<A...>();
    static_assert(given > 0, "a vector needs its elements");
    static_assert(given == n || (sizeof...(A) == 1 && given == 1),
                  "the elements given don't fill the vector (Metal wants exactly as many, or one to splat)");
    E e[4] = {};
    int k = 0;
    (__mtl::put(e, k, a), ...);
    V v;
    for (int i = 0; i < n; i++) v[i] = (given == 1) ? e[0] : e[i];
    return v;
}

// float3(v < w), float4(v < w, 0, 1): metal.py wraps a comparison among a vector's elements, as
// Metal's true is 1 and clang's -1
inline bool __mtl_truth(bool b) { return b; }
template <class V> inline V __mtl_truth(V v) {
    if constexpr (__mtl::traits<V>::n == 1) return v;
    else {
        V r;
        for (int i = 0; i < __mtl::traits<V>::n; i++) r[i] = v[i] ? 1 : 0;
        return r;
    }
}

// ---- matrices, by columns

template <int C, int R> struct __mtl_matrix;
#define MTL_MATRIX(C, R, COL)                                                                   \
    template <> struct __mtl_matrix<C, R> {                                                     \
        COL columns[C];                                                                         \
        COL &operator[](int i) { return columns[i]; }                                           \
        const COL &operator[](int i) const { return columns[i]; }                               \
    };
MTL_MATRIX(2, 2, float2) MTL_MATRIX(3, 3, float3) MTL_MATRIX(4, 4, float4)
#undef MTL_MATRIX
typedef __mtl_matrix<2, 2> float2x2;
typedef __mtl_matrix<3, 3> float3x3;
typedef __mtl_matrix<4, 4> float4x4;
namespace __mtl {
template <> struct traits<float2x2> { static constexpr int n = 2; typedef float2 elem; };
template <> struct traits<float3x3> { static constexpr int n = 3; typedef float3 elem; };
template <> struct traits<float4x4> { static constexpr int n = 4; typedef float4 elem; };
template <int N> struct column_of;
template <> struct column_of<2> { typedef float2 type; };
template <> struct column_of<3> { typedef float3 type; };
template <> struct column_of<4> { typedef float4 type; };
}  // namespace __mtl

// float3x3(c0, c1, c2) by columns; float3x3(s) the diagonal; or every element, column by column
template <class M, class... A> inline M __mtl_make_matrix(A... a) {
    constexpr int n = __mtl::traits<M>::n;
    typedef typename __mtl::column_of<n>::type Col;
    M m;
    if constexpr (sizeof...(A) == 1 && __mtl::total<A...>() == 1) {
        float s = float(a...);
        for (int c = 0; c < n; c++) { m.columns[c] = Col(0); m.columns[c][c] = s; }
    } else {
        static_assert(__mtl::total<A...>() == n * n, "a matrix wants its columns, or every element");
        float e[16] = {};
        int k = 0;
        (__mtl::put(e, k, a), ...);
        for (int c = 0; c < n; c++) for (int r = 0; r < n; r++) m.columns[c][r] = e[c * n + r];
    }
    return m;
}

template <int N> inline typename __mtl::column_of<N>::type operator*(const __mtl_matrix<N, N> &m, typename __mtl::column_of<N>::type v) {
    typename __mtl::column_of<N>::type r = 0;
    for (int c = 0; c < N; c++) r += m.columns[c] * v[c];
    return r;
}
template <int N> inline typename __mtl::column_of<N>::type operator*(typename __mtl::column_of<N>::type v, const __mtl_matrix<N, N> &m) {
    typename __mtl::column_of<N>::type r;
    for (int c = 0; c < N; c++) { float s = 0; for (int i = 0; i < N; i++) s += v[i] * m.columns[c][i]; r[c] = s; }
    return r;
}
template <int N> inline __mtl_matrix<N, N> operator*(const __mtl_matrix<N, N> &a, const __mtl_matrix<N, N> &b) {
    __mtl_matrix<N, N> r;
    for (int c = 0; c < N; c++) r.columns[c] = a * b.columns[c];
    return r;
}
template <int N> inline __mtl_matrix<N, N> operator*(const __mtl_matrix<N, N> &a, float s) {
    __mtl_matrix<N, N> r;
    for (int c = 0; c < N; c++) r.columns[c] = a.columns[c] * s;
    return r;
}
template <int N> inline __mtl_matrix<N, N> operator*(float s, const __mtl_matrix<N, N> &a) { return a * s; }
template <int N> inline __mtl_matrix<N, N> operator+(const __mtl_matrix<N, N> &a, const __mtl_matrix<N, N> &b) {
    __mtl_matrix<N, N> r;
    for (int c = 0; c < N; c++) r.columns[c] = a.columns[c] + b.columns[c];
    return r;
}
template <int N> inline __mtl_matrix<N, N> operator-(const __mtl_matrix<N, N> &a, const __mtl_matrix<N, N> &b) {
    __mtl_matrix<N, N> r;
    for (int c = 0; c < N; c++) r.columns[c] = a.columns[c] - b.columns[c];
    return r;
}

#include "metal_runtime.h"

namespace metal {

namespace __detail {
template <class V, class F> inline V map1(V a, F f) {
    if constexpr (__mtl::count<V>() == 1) return f(a);
    else { V r; for (int i = 0; i < __mtl::count<V>(); i++) r[i] = f(a[i]); return r; }
}
template <class V, class F> inline V map2(V a, V b, F f) {
    if constexpr (__mtl::count<V>() == 1) return f(a, b);
    else { V r; for (int i = 0; i < __mtl::count<V>(); i++) r[i] = f(a[i], b[i]); return r; }
}
template <class V, class F> inline V map3(V a, V b, V c, F f) {
    if constexpr (__mtl::count<V>() == 1) return f(a, b, c);
    else { V r; for (int i = 0; i < __mtl::count<V>(); i++) r[i] = f(a[i], b[i], c[i]); return r; }
}
inline float clampf(float x, float a, float b) { return __builtin_fminf(__builtin_fmaxf(x, a), b); }
inline float smooth01(float t) { return t * t * (3.0f - 2.0f * t); }
}  // namespace __detail

